
<style>
        
    </style>
    <div class="mt-slideshow-wrapper">
        <div class="mt-slideshow-container swiper mt-slideshow-slider">
                <div class="swiper-wrapper">
                  {% for block in section.blocks %}
                    <div class="swiper-slide mt-slideshow-item">
                        <div class="mt-slideshow-item__image-container mt-slide-show__desktop" {% if block.settings.mobile_image == blank %} style="display: block" {% endif %}>
                            {% if block.settings.image != blank %}
                              {% if block.settings.button_link and block.settings.button_text == blank %}
                                <a href="{{ block.settings.button_link }}">
                                  {{ block.settings.image | image_url: width: 1800 | image_tag }}
                                </a>
                              {% else %}
                                  {{ block.settings.image | image_url: width: 1800 | image_tag }}
                              {% endif %}
                            {% else %}
                            {{ 'lifestyle-1' | placeholder_svg_tag: 'image-with-text-placeholder-image' }}
                            {% endif %}
                            
                        </div>
                        <div class="mt-slideshow-item__image-container mt-slide-show__mobile" {% if block.settings.mobile_image == blank %} style="display: none" {% endif %}>
                            {% if block.settings.image != blank %}
                              {% if block.settings.button_link and block.settings.button_text == blank %}
                                <a href="{{ block.settings.button_link }}">
                                  {{ block.settings.image | image_url: width: 1800 | image_tag }}
                                </a>
                              {% else %}
                                  {{ block.settings.image | image_url: width: 1800 | image_tag }}
                              {% endif %}
                            {% else %}
                            {{ 'lifestyle-1' | placeholder_svg_tag: 'image-with-text-placeholder-image' }}
                            {% endif %}
                        </div>
                        <div class="mt-slideshow-item__info-container ">
                            <div class="page-width">
                                <div class="mt-slideshow-item__content ">
                                  {% if block.settings.title != blank  %}
                                    <h2 class="{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                                      {% if settings.animations_reveal_on_scroll %}
                                        data-cascade
                                        style="--animation-order: {{ forloop.index }};"
                                      {% endif %}>{{ block.settings.title }}</h2>
                                    {%endif %}
                                    <p class="{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                                      {% if settings.animations_reveal_on_scroll %}
                                        data-cascade
                                        style="--animation-order: {{ forloop.index }};"
                                      {% endif %}>{{ block.settings.description }}</p>
                                    <a href="{{ block.settings.button_link }}" class="mt-slideshow-button {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                                      {% if settings.animations_reveal_on_scroll %}
                                        data-cascade
                                        style="--animation-order: {{ forloop.index }};"
                                      {% endif %}>{{ block.settings.button_text }}</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                    
                </div>
                <!-- <div class="swiper-button-next">Next</div>
                <div class="swiper-button-prev">prev</div> -->
        </div>
        <div class="swiper-pagination"></div>
    </div>

      <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    
      <script>
        var swiper = new Swiper(".mt-slideshow-slider", {
          centeredSlides: true,
          autoplay: {
            delay: 5000,
            disableOnInteraction: false,
          },
          pagination: {
            el: ".swiper-pagination",
            clickable: true,
          },
          navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
          },
        });
      </script>
{% schema %}
  {
    "name": "Custom Slideshow",
    "tag": "section",
    "settings": [],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "limit": 6,
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "image_picker",
            "id": "mobile_image",
            "label": "Mobile Image"
          },
          {
              "type": "text",
              "id": "title",
              "label": "Heading",
              "default": "Heading Text Here"
           },
          {
              "type": "textarea",
              "id": "description",
              "label": "Description",
              "default": "Lorem ipsum dolar sit amit."
          },
          {
              "type": "text",
              "id": "button_text",
              "label": "Button Text",
              "default": "Button Text"
          },
          {
              "type": "url",
              "id": "button_link",
              "label": "Button link"
          },
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom Slideshow",
        "blocks": [
          {
            "type": "slide"
          },
          {
            "type": "slide"
          },
          {
            "type": "slide"
          }
        ]
      }
    ]
  }
{% endschema %}