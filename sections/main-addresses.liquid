<script>
  const buttons = document.querySelectorAll('.mt-account-tab-button');
  const contents = document.querySelectorAll('.mt-account-tab-content');
  
  // Function to activate Addresses tab and content
  function activateAddressesTab() {
    buttons.forEach(btn => btn.classList.remove('active'));
    contents.forEach(content => content.classList.remove('active'));
  
    const addressButton = document.querySelector('[data-tab="addresses"]');
    const addressContent = document.getElementById('addresses');
  
    if (addressButton) addressButton.classList.add('active');
    if (addressContent) addressContent.classList.add('active');
  }
  
  // When page loads, activate Addresses tab
  activateAddressesTab();
  
  // Listen to button clicks
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-tab');
      if (tabId !== 'addresses') {
        window.location.href = `{{ shop .url }}/account?tab=${tabId}`;
      } else {
        activateAddressesTab(); // stay on addresses
      }
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    function setDefaultCountry() {
      var countrySelect = document.querySelector('select[name="address[country]"]');
  
      if (countrySelect) {
        var selectedOption = countrySelect.options[countrySelect.selectedIndex];
        
        // Only change if no country is selected
        if (!selectedOption || !selectedOption.value) {
          const defaultCountry = 'United States'; // <<< your desired default
  
          for (var i = 0; i < countrySelect.options.length; i++) {
            if (countrySelect.options[i].text.trim() === defaultCountry) {
              countrySelect.selectedIndex = i;
              countrySelect.dispatchEvent(new Event('change')); // trigger state/province reload
              break;
            }
          }
        }
      }
    }
  
    // Wait 1 second (1000 milliseconds)
    setTimeout(setDefaultCountry, 1000);
  });
  </script>
  
  


