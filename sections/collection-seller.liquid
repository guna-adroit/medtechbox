<style>
    .mt-seller-section-container{
        display: flex;
        align-items: center;
        gap: 30px;
        margin-top: 30px;
        margin-bottom: 30px;
    }
    .mt-seller-section-column{
        width: calc(50% - 15px);
        
    }
    .seller-featured-image{
        width: 100%;
    }
    @media screen and (max-width: 768px){
        .mt-seller-section-container{
            flex-direction: column;
            gap: 20px;
        }
        .mt-seller-section-column{
            width: 100%;
        }
    }
</style>
<div class="mt-seller-section-wrapper page-width">
    <div class="mt-seller-section-container">
        <div class="mt-seller-section-column">
            {% if collection.metafields.custom.seller_logo != blank %}
                <img class="seller-logo" src="{{ collection.metafields.custom.seller_logo | image_url: width: 200 }}" alt="">
            {% endif %}
            <p>{{ collection.metafields.custom.seller_description }}</p>
        </div>
        <div class="mt-seller-section-column">
            {% if collection.metafields.custom.seller_featured_image != blank %}
                <img class="seller-featured-image" src="{{ collection.metafields.custom.seller_featured_image | image_url: width: 800 }}" alt="">
            {% endif %}
        </div>
    </div>
</div>

{% schema %}
        {
            "name": "Seller Details",
            "tag": "section",
            "settings": [
                
            ],
            "presets": [
                {
                    "name": "Seller Details"
                }
            ]
        }
    {% endschema %}