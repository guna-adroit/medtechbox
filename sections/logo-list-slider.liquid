<style>
.mt-logo-list-wrapper-{{section.id}}{
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
  @media screen and (max-width: 750px){
    .mt-logo-list-wrapper-{{section.id}}{
      padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
    }
  }
</style>
    <div class="mt-logo-list-wrapper mt-logo-list-wrapper-{{ section.id }}" style="background-color: {{section.settings.bg_color}};">
        <div class="page-width">
              {% if section.settings.title != blank %}
                  <div class="mt-logo-list-title-container section-title-container">
                      <h2 class="section-title">{{ section.settings.title }}</h2>
                      {% if section.settings.button_text != blank %}
                          <a href="{{section.settings.button_link}}">
                              <div class="title-link-block">
                                  <p>{{section.settings.button_text}}</p>
                                  <svg xmlns="http://www.w3.org/2000/svg" width="8" height="12" viewBox="0 0 8 12" fill="none">
                                      <path d="M2.00006 10.2961L6.1925 6.10363L2.08887 2" stroke="#222222" stroke-width="2" stroke-linecap="square"/>
                                  </svg>
                              </div>
                          </a>
                      {% endif %}
                  </div>
              {% endif %}
            <div class="mt-logo-list-container">
                <div class="swiper-container">
                    <div class="swiper-button-prev">
                      <img src="https://cdn.shopify.com/s/files/1/0641/5781/0850/files/icon-prev.svg?v=1741598113" width="" height="" alt="">
                    </div>
                    <div class="swiper mt-logo-list-slider mt-logo-list-slider-{{section.id}}">
                      <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                        <div class="swiper-slide" style="height: {{ block.settings.logo_height }}px;">
                            {% if block.settings.image != blank %}
                                {% if block.settings.image_url != blank %}
                                    <a href="{{ block.settings.image_url }}">
                                        <img src="{{ block.settings.image |  image_url: width: 600 }}" style="height: {{ block.settings.logo_height }}px;" width="" height="" alt=""/>
                                    </a>
                                {% else %}
                                    <img src="{{ block.settings.image |  image_url: width: 600 }}" style="height: {{ block.settings.logo_height }}px;" width="" height="" alt=""/>
                                {% endif %}
                            {% else %}
                                {{ 'image' | placeholder_svg_tag: 'image-with-text-placeholder-image' }}
                            {% endif %}
                        </div>
                        {% endfor %}
                        
                      </div>
                      
                    </div>
                    <div class="swiper-button-next">
                      <img src="https://cdn.shopify.com/s/files/1/0641/5781/0850/files/icon-next.svg?v=1741598113" width="" height="" alt="">
                    </div>
                    
                    <div class="swiper-pagination"></div>
                  </div>
            </div>
        </div>
        
    </div>


    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".mt-logo-list-slider-{{section.id}}", {
          loop: true, // Enable looping of logos
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },
          breakpoints: {
            280: {
              slidesPerView: 3,
              spaceBetween: 15,
            },
            480: {
              slidesPerView: 3,
              spaceBetween: 18,
            },
            640: {
              slidesPerView: 3,
              spaceBetween: 30,
            },
            768: {
              slidesPerView: 4,
              spaceBetween: 30,
            },
            1024: {
              slidesPerView: 5,
              spaceBetween: 30,
            },
          },
        });
      </script>

{% schema %}
    {
        "name": "Logo List",
        "tag": "section",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Heading",
                "default": "Heading Text Here"
            },
            {
                "type": "text",
                "id": "button_text",
                "label": "Link Text",
                "default": "Button Text"
            },
            {
                "type": "url",
                "id": "button_link",
                "label": "Link"
            },
            {
                "type": "color",
                "id": "bg_color",
                "label": "Background Color",
                "default": "#F7F8F8"
            },
            {
              "type": "range",
              "id": "padding_top",
              "min": 12,
              "max": 64,
              "step": 1,
              "unit": "px",
              "label": "Padding Top",
              "default": 25
            },
            {
              "type": "range",
              "id": "padding_bottom",
              "min": 12,
              "max": 64,
              "step": 1,
              "unit": "px",
              "label": "Padding Top",
              "default": 25
            }
        ],
        "blocks": [
            {
                "type": "logo",
                "name": "Logo",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "url",
                        "id": "image_url",
                        "label": "URL"
                    },
                    {
                        "type": "range",
                        "id": "logo_height",
                        "min": 30,
                        "max": 60,
                        "step": 5,
                        "unit": "px",
                        "label": "Logo height",
                        "default": 30
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Logo list slider",
                "blocks": [
                    {
                        "type": "logo"
                    },
                    {
                        "type": "logo"
                    },
                    {
                        "type": "logo"
                    },
                    {
                        "type": "logo"
                    },
                    {
                        "type": "logo"
                    },
                    {
                        "type": "logo"
                    },
                ]
            }
        ]
    }
{% endschema %}
