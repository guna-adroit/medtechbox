{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link cart__title-wrapper">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}
        {% if cart.empty? != true %}
          <span id="cart-header-count">({{ cart.item_count }})</span>
        {% endif %}
      </h1>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}} {{- 'icon-caret.svg' | inline_asset_content -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>
      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    {% assign vendors = "" %}
    {% for item in cart.items %}
      {% unless vendors contains item.vendor %}
        {% assign vendors = vendors | append: item.vendor | append: "," %}
      {% endunless %}
    {% endfor %}
    {% assign vendor_list = vendors | split: "," %}
    {% assign total_shipments = 0 %}
    {% for vendor in vendor_list %}
      {% if vendor != blank %}
        {% assign total_shipments = total_shipments | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% assign shipment_count = 1 %}

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart" novalidate>
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">

          {%- if cart != empty -%}
            {% for vendor in vendor_list %}
              {% if vendor != blank %}
                {% assign vendor_name = vendor | handleize %}
                {% assign vendor_line_indices = "" %}
                {% for item in cart.items %}
                  {% if item.vendor == vendor %}
                    {% assign item_line = item.index | plus: 1 %}
                    {% assign vendor_line_indices = vendor_line_indices | append: item_line | append: "," %}
                  {% endif %}
                {% endfor %}

                <div class="shipment">
                  <h3 class="strong"><strong>Delivery {{ shipment_count }} of {{ total_shipments }}</strong></h3>
                  <p><strong>Vendor:</strong> {{ vendor }}</p>

                  <div class="vendor-note">
                    <label for="vendor-note-{{ vendor_name }}">PO Number:</label>
                    <input
                      type="text"
                      id="vendor-note-{{ vendor_name }}"
                      placeholder="Enter PO Number for {{ vendor }}"
                      data-vendor-note
                      data-vendor="{{ vendor | escape }}"
                      data-line-indices="{{ vendor_line_indices | remove_last: ',' }}"
                    >
                    <span class="vendor-note-saved" id="saved-{{ vendor_name }}" style="display:none; color:green; font-size:12px;">Saved ✓</span>
                  </div>

                  <table class="cart-items">
                    <caption class="visually-hidden">{{ 'sections.cart.title' | t }}</caption>
                    <thead>
                      <tr>
                        <th class="caption-with-letter-spacing" colspan="2" scope="col">{{ 'sections.cart.headings.product' | t }}</th>
                        <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">{{ 'sections.cart.headings.total' | t }}</th>
                        <th class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing" colspan="1" scope="col">{{ 'sections.cart.headings.quantity' | t }}</th>
                        <th class="small-hide center caption-with-letter-spacing" colspan="1" scope="col">{{ 'sections.cart.headings.total' | t }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {%- for item in cart.items -%}
                        {% if item.vendor == vendor %}
                          <tr class="cart-item" id="CartItem-{{ item.index | plus: 1 }}">
                            <td class="cart-item__media">
                              {% if item.image %}
                                <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                                <div class="cart-item__image-container gradient global-media-settings">
                                  <img
                                    src="{{ item.image | image_url: width: 300 }}"
                                    class="cart-item__image"
                                    alt="{{ item.image.alt | escape }}"
                                    loading="lazy"
                                    width="150"
                                    height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                                  >
                                </div>
                              {% endif %}
                            </td>

                            <td class="cart-item__details">
                              {%- if settings.show_vendor -%}
                                <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                              {%- endif -%}
                              <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                              {%- if item.original_price != item.final_price -%}
                                <div class="cart-item__discounted-prices">
                                  <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                                  <s class="cart-item__old-price product-option">{{- item.original_price | money -}}</s>
                                  <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                                  <strong class="cart-item__final-price product-option">{{ item.final_price | money }}</strong>
                                </div>
                              {%- else -%}
                                <div class="product-option">{{ item.original_price | money }}</div>
                              {%- endif -%}

                              {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != null -%}
                                <dl>
                                  {%- if item.product.has_only_default_variant == false -%}
                                    {%- for option in item.options_with_values -%}
                                      <div class="product-option"><dt>{{ option.name }}:</dt><dd>{{ option.value }}</dd></div>
                                    {%- endfor -%}
                                  {%- endif -%}
                                  <div class="product-option"><dt>SKU:</dt><dd>{{ item.sku }}</dd></div>
                                  {%- for property in item.properties -%}
                                    {%- assign property_first_char = property.first | slice: 0 -%}
                                    {%- if property.last != blank and property_first_char != '_' -%}
                                      <div class="product-option">
                                        <dt>{{ property.first }}:</dt>
                                        <dd>
                                          {%- if property.last contains '/uploads/' -%}
                                            <a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>
                                          {%- else -%}
                                            {{ property.last }}
                                          {%- endif -%}
                                        </dd>
                                      </div>
                                    {%- endif -%}
                                  {%- endfor -%}
                                </dl>
                                <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                              {%- endif -%}

                              <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                                {%- for discount in item.line_level_discount_allocations -%}
                                  <li class="discounts__discount">
                                    {{- 'icon-discount.svg' | inline_asset_content -}}
                                    {{ discount.discount_application.title | escape }}
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </td>

                            <td class="cart-item__totals right medium-hide large-up-hide">
                              {%- render 'loading-spinner' -%}
                              <div class="cart-item__price-wrapper">
                                {%- if item.original_line_price != item.final_line_price -%}
                                  <dl class="cart-item__discounted-prices">
                                    <dt class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</dt>
                                    <dd><s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s></dd>
                                    <dt class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</dt>
                                    <dd class="price price--end">{{ item.final_line_price | money }}</dd>
                                  </dl>
                                {%- else -%}
                                  <span class="price price--end">{{ item.original_line_price | money }}</span>
                                {%- endif -%}
                              </div>
                            </td>

                            {%- liquid
                              assign has_qty_rules = false
                              if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                                assign has_qty_rules = true
                              endif
                              assign has_vol_pricing = false
                              if item.variant.quantity_price_breaks.size > 0
                                assign has_vol_pricing = true
                              endif
                            -%}
                            <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                              <quantity-popover>
                                <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                                  <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">{{ 'products.product.quantity.label' | t }}</label>
                                  <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                    <quantity-input class="quantity cart-quantity">
                                      <button class="quantity__button" name="minus" type="button">
                                        <span class="visually-hidden">{{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}</span>
                                        <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                                      </button>
                                      <input
                                        class="quantity__input"
                                        data-quantity-variant-id="{{ item.variant.id }}"
                                        type="number"
                                        name="updates[]"
                                        value="{{ item.quantity }}"
                                        {% # theme-check-disable %}
                                        data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                        min="0"
                                        data-min="{{ item.variant.quantity_rule.min }}"
                                        {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                                        step="{{ item.variant.quantity_rule.increment }}"
                                        {% # theme-check-enable %}
                                        aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                        id="Quantity-{{ item.index | plus: 1 }}"
                                        data-index="{{ item.index | plus: 1 }}"
                                      >
                                      <button class="quantity__button" name="plus" type="button">
                                        <span class="visually-hidden">{{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}</span>
                                        <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                                      </button>
                                    </quantity-input>
                                  </div>
                                  <cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                                    <a href="{{ item.url_to_remove }}" class="button button--tertiary" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">
                                      <span class="svg-wrapper">{{- 'icon-remove.svg' | inline_asset_content -}}</span>
                                    </a>
                                  </cart-remove-button>
                                </div>
                                <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                                  <small class="cart-item__error-text"></small>
                                  <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                                </div>
                              </quantity-popover>
                            </td>

                            <td class="cart-item__totals right small-hide">
                              {%- render 'loading-spinner' -%}
                              <div class="cart-item__price-wrapper">
                                {%- if item.original_line_price != item.final_line_price -%}
                                  <dl class="cart-item__discounted-prices">
                                    <dt class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</dt>
                                    <dd><s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s></dd>
                                    <dt class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</dt>
                                    <dd class="price price--end">{{ item.final_line_price | money }}</dd>
                                  </dl>
                                {%- else -%}
                                  <span class="price price--end">{{ item.original_line_price | money }}</span>
                                {%- endif -%}
                              </div>
                            </td>
                          </tr>
                        {% endif %}
                      {%- endfor -%}
                    </tbody>
                  </table>

                  {% render 'cart-shipping-estimate', vendor: vendor %}
                </div>

                {% assign shipment_count = shipment_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {%- endif -%}

        </div>
      </div>

     
      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
        {{ 'accessibility.loading' | t }}
      </p>
    </form>

  </div>
</cart-items>

<script>
  (function () {
  'use strict';

  function getCart() {
    return fetch('/cart.js').then(function (r) {
      if (!r.ok) throw new Error('Failed to fetch cart: ' + r.status);
      return r.json();
    });
  }

  function updateLine(lineIndex, properties) {
    console.log('[Cart] Updating line', lineIndex, 'with properties:', properties);
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: lineIndex, properties: properties })
    })
    .then(function (r) {
      if (!r.ok) {
        return r.text().then(function (msg) {
          throw new Error('cart/change.js ' + r.status + ': ' + msg);
        });
      }
      return r.json();
    });
  }

  function runSequentially(tasks) {
    return tasks.reduce(function (chain, task) {
      return chain.then(task);
    }, Promise.resolve());
  }

  /* ─────────────────────────────────────────────────────
     GET LINE NUMBER BY ITEM KEY
     item.index does NOT exist in cart.js response
     Position in array = line number (1-based)
  ───────────────────────────────────────────────────── */
  function getLineNumber(cartItems, key) {
    var pos = cartItems.findIndex(function (i) { return i.key === key; });
    return pos === -1 ? null : pos + 1; // ✅ 1-based line number
  }

  /* ─────────────────────────────────────────────────────
     1. AUTO-SET VENDOR NAME ON PAGE LOAD
  ───────────────────────────────────────────────────── */
  function setVendorLineProperties() {
    console.log('[VendorProperty] Checking vendor properties…');

    getCart()
      .then(function (cart) {
        if (!cart.items.length) return;

        var itemsNeedingUpdate = cart.items.filter(function (item) {
          return !item.properties || item.properties['Vendor'] !== item.vendor;
        });

        if (!itemsNeedingUpdate.length) {
          console.log('[VendorProperty] All items already up to date.');
          return;
        }

        console.log('[VendorProperty] Updating', itemsNeedingUpdate.length, 'item(s)…');

        var tasks = itemsNeedingUpdate.map(function (targetItem) {
          return function () {
            return getCart().then(function (freshCart) {
              var lineNumber = getLineNumber(freshCart.items, targetItem.key);

              if (!lineNumber) {
                console.warn('[VendorProperty] Item not found:', targetItem.key);
                return;
              }

              var freshItem = freshCart.items[lineNumber - 1];
              var mergedProperties = Object.assign({}, freshItem.properties, {
                'Vendor': freshItem.vendor
              });

              return updateLine(lineNumber, mergedProperties)
                .then(function () {
                  console.log('[VendorProperty] ✓ Line', lineNumber, '— Vendor set to:', freshItem.vendor);
                });
            });
          };
        });

        return runSequentially(tasks);
      })
      .catch(function (err) {
        console.error('[VendorProperty] Failed:', err);
      });
  }

  /* ─────────────────────────────────────────────────────
     2. VENDOR NOTE INPUTS
  ───────────────────────────────────────────────────── */
  function saveVendorNote(vendor, noteValue) {
    return getCart().then(function (cart) {
      var vendorItems = cart.items.filter(function (item) {
        return item.vendor === vendor;
      });

      if (!vendorItems.length) {
        console.warn('[VendorNote] No items for vendor:', vendor);
        return;
      }

      var tasks = vendorItems.map(function (item) {
        return function () {
          return getCart().then(function (freshCart) {
            var lineNumber = getLineNumber(freshCart.items, item.key);

            if (!lineNumber) {
              console.warn('[VendorNote] Item not found:', item.key);
              return;
            }

            var freshItem = freshCart.items[lineNumber - 1];
            var mergedProperties = Object.assign({}, freshItem.properties, {
              'Vendor':      freshItem.vendor,
              'PO Number': noteValue
            });

            return updateLine(lineNumber, mergedProperties)
              .then(function () {
                console.log('[VendorNote] ✓ Line', lineNumber, 'note saved for:', vendor);
              });
          });
        };
      });

      return runSequentially(tasks);
    });
  }

  function initVendorNoteInputs() {
    var noteInputs = document.querySelectorAll('[data-vendor-note]');
    console.log('[VendorNote] Found', noteInputs.length, 'vendor note input(s)');

    noteInputs.forEach(function (input) {
      input.addEventListener('invalid', function (e) { e.preventDefault(); });

      var debounceTimer;

      input.addEventListener('input', function () {
        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(function () {
          var vendor    = input.getAttribute('data-vendor');
          var noteValue = input.value.trim();

          if (!vendor) {
            console.error('[VendorNote] Missing data-vendor on input:', input);
            return;
          }

          console.log('[VendorNote] Saving note for "' + vendor + '":', noteValue);

          saveVendorNote(vendor, noteValue)
            .then(function () {
              var vendorName = input.id.replace('vendor-note-', '');
              var savedMsg   = document.getElementById('saved-' + vendorName);
              if (savedMsg) {
                savedMsg.style.display = 'inline';
                setTimeout(function () { savedMsg.style.display = 'none'; }, 1500);
              }
            })
            .catch(function (err) {
              console.error('[VendorNote] Save failed:', err);
            });

        }, 400);
      });
    });
  }

  /* ─────────────────────────────────────────────────────
     BOOT
  ───────────────────────────────────────────────────── */
  function init() {
    setVendorLineProperties();
    initVendorNoteInputs();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
