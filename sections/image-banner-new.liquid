<style>
    .mt-image-banner-new-container-{{ section.id }}{
        position: relative;
    }
    .mt-image-banner-new-content-{{ section.id }}{
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: {{ section.settings.content_alignment }};
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        height: 100%;
        width: 100%;
        justify-content: center;
        text-align: {{ section.settings.text_alignment }};
    }
    .image-banner-content-{{ section.id }} .image-banner-new-heading *{
        font-size: {{ section.settings.heading_font_size }}px !important;
        font-weight: {{ section.settings.heading_font_weight }};
        margin: 0;
        line-height: 100%;
        color: {{ section.settings.text_color }} !important;
    }
    .image-banner-content-{{ section.id }} .image-banner-new-subheading *{
        font-size: {{ section.settings.subheading_font_size }}px !important;
        font-weight: {{ section.settings.subheading_font_weight }};
        margin: 0;
        line-height: 100%;
        color: {{ section.settings.text_color }} !important;
    }
    .image-banner-content-{{ section.id }}{
        max-width: {{ section.settings.content_width }}px;
    }
        .mt-image-banner-new-container img{
            width: 100%;
            height: auto;
        }

  .image-banner-btn-{{ section.id }} {
    display: inline-block;
    color: {{ section.settings.button_text_color }}; /* default text color, can add schema if needed */
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }
  .image-banner-content-{{ section.id }} .image-banner-btn-wrapper {
    margin-top: 10px;
  }

  {% if section.settings.button_below_text != blank%}
    .image-banner-content-{{ section.id }} .image-banner-btn-wrapper {
        display: flex;
        gap: 10px;
        align-items: center;
        {% if section.settings.additional_layout %}
            flex-direction: column;
            align-items: unset;
        {% endif %}
    }
    .image-banner-content-{{ section.id }} .image-banner-btn-wrapper a{
        flex: 0 0 auto;
    }
  {% endif %}
  {% if section.settings.button_full_width %}
    .image-banner-content-{{ section.id }} .image-banner-btn-wrapper {
        display: flex;
    }
    .image-banner-content-{{ section.id }} .image-banner-btn-wrapper a{
        flex: 1 1 100%;
        text-align: center;
    }
  {% endif %}
    .image-banner-content-{{ section.id }} .image-banner-btn-wrapper .button-additional-text{
        font-weight: {{ section.settings.below_text_font_weight }};
        margin: 0;
        line-height: 110%;
    }

  /* Optional size variations */
  {% case section.settings.button_size %}
    {% when 'small' %}
      .image-banner-btn-{{ section.id }} { font-size: 14px; }
    {% when 'medium' %}
      .image-banner-btn-{{ section.id }} { font-size: 16px; }
    {% when 'large' %}
      .image-banner-btn-{{ section.id }} { font-size: 18px; }
  {% endcase %}

  .image-banner-btn:hover {
    opacity: 0.85;
  }
  .mt-image-banner-new-desktop-image{
    width: 100%;
    height: auto;
    }
  .mt-image-banner-new-mobile-image{
    width: 100%;
    height: auto;
    display: none;
  }
  .image-banner-btn-{{ section.id }}{
    background-color: {{ section.settings.button_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_radius }}px;
    font-weight: {{ section.settings.button_font_weight }};
  }
  .image-banner-content-{{ section.id }} .button-additional-text{
    color: {{ section.settings.button_below_text_color }};
    font-size:{{ section.settings.font-size }}px;
  }
  {% if section.settings.mobile-image != blank %}
    @media screen and (max-width: 1024px){
        .mt-image-banner-new-container-{{ section.id }} .mt-image-banner-new-desktop-image,
        .mt-image-banner-new-content-{{ section.id }}{
            display: none;
        }
        .mt-image-banner-new-container-{{ section.id }} .mt-image-banner-new-mobile-image{
            display: block;
        }
    }
  {% endif %}

  @media screen and (max-width: 820px){
    .image-banner-content-{{ section.id }} .image-banner-new-heading *{
        font-size: calc({{ section.settings.heading_font_size }}px * 0.7) !important;
    }
    .image-banner-content-{{ section.id }} .image-banner-new-subheading *{
        font-size: calc({{ section.settings.subheading_font_size }}px * 0.7) !important;
    }
}
    @media screen and (min-width: 1370px){
        .mt-image-banner-new-content-{{ section.id }}.page-width{
            max-width: 230rem;
        }
        .image-banner-content-{{ section.id }}{
            max-width: calc({{ section.settings.content_width }}px * 1.15);
        }
        .image-banner-content-{{ section.id }} .image-banner-new-heading *{
            font-size: calc({{ section.settings.heading_font_size }}px * 1.15) !important;
        }
        .image-banner-content-{{ section.id }} .image-banner-new-subheading *{
            font-size: calc({{ section.settings.subheading_font_size }}px * 1.15) !important;
        }
        {% case section.settings.button_size %}
            {% when 'small' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(14px * 1.1); }
            {% when 'medium' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(16px * 1.1); }
            {% when 'large' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(18px * 1.1); }
        {% endcase %}
        .image-banner-btn-{{ section.id }}{
            padding: calc({{ section.settings.button_padding_vertical }}px * 1.1) calc({{ section.settings.button_padding_horizontal }}px * 1.1);
            border-radius: calc({{ section.settings.button_radius }}px * 1.1);
        }
        .image-banner-content-{{ section.id }} .button-additional-text{
            font-size: calc({{ section.settings.font-size }}px * 1.15);
        }
    }

    @media screen and (min-width: 1640px){
        .mt-image-banner-new-content-{{ section.id }}.page-width{
            max-width: 230rem;
        }
        .image-banner-content-{{ section.id }}{
            max-width: calc({{ section.settings.content_width }}px * 1.6);
        }
        .image-banner-content-{{ section.id }} .image-banner-new-heading *{
            font-size: calc({{ section.settings.heading_font_size }}px * 1.4) !important;
        }
        .image-banner-content-{{ section.id }} .image-banner-new-subheading *{
            font-size: calc({{ section.settings.subheading_font_size }}px * 1.4) !important;
        }
        {% case section.settings.button_size %}
            {% when 'small' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(14px * 1.4); }
            {% when 'medium' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(16px * 1.4); }
            {% when 'large' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(18px * 1.4); }
        {% endcase %}
        .image-banner-btn-{{ section.id }}{
            padding: calc({{ section.settings.button_padding_vertical }}px * 1.4) calc({{ section.settings.button_padding_horizontal }}px * 1.4);
            border-radius: calc({{ section.settings.button_radius }}px * 1.4);
        }
        .image-banner-content-{{ section.id }} .button-additional-text{
            font-size: calc({{ section.settings.font-size }}px * 1.4);
        }
    }


    @media screen and (min-width: 1920px){
        .mt-image-banner-new-content-{{ section.id }}.page-width{
            max-width: 230rem;
        }
        .image-banner-content-{{ section.id }}{
            max-width: calc({{ section.settings.content_width }}px * 1.8);
        }
        .image-banner-content-{{ section.id }} .image-banner-new-heading *{
            font-size: calc({{ section.settings.heading_font_size }}px * 1.65) !important;
        }
        .image-banner-content-{{ section.id }} .image-banner-new-subheading *{
            font-size: calc({{ section.settings.subheading_font_size }}px * 1.65) !important;
        }
        {% case section.settings.button_size %}
            {% when 'small' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(14px * 1.65); }
            {% when 'medium' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(16px * 1.65); }
            {% when 'large' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(18px * 1.65); }
        {% endcase %}
        .image-banner-btn-{{ section.id }}{
            padding: calc({{ section.settings.button_padding_vertical }}px * 1.65) calc({{ section.settings.button_padding_horizontal }}px * 1.65);
            border-radius: calc({{ section.settings.button_radius }}px * 1.65);
        }
        .image-banner-content-{{ section.id }} .button-additional-text{
            font-size: calc({{ section.settings.font-size }}px * 1.65);
        }
    }

    @media screen and (min-width: 2420px){
        .mt-image-banner-new-content-{{ section.id }}.page-width{
            max-width: 250rem;
        }
        .image-banner-content-{{ section.id }}{
            max-width: calc({{ section.settings.content_width }}px * 2.3);
        }
        .image-banner-content-{{ section.id }} .image-banner-new-heading *{
            font-size: calc({{ section.settings.heading_font_size }}px * 2.2) !important;
        }
        .image-banner-content-{{ section.id }} .image-banner-new-subheading *{
            font-size: calc({{ section.settings.subheading_font_size }}px * 2.2) !important;
        }
        {% case section.settings.button_size %}
            {% when 'small' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(14px * 2.2); }
            {% when 'medium' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(16px * 2.2); }
            {% when 'large' %}
            .image-banner-btn-{{ section.id }} { font-size: calc(18px * 2.2); }
        {% endcase %}
        .image-banner-btn-{{ section.id }}{
            padding: calc({{ section.settings.button_padding_vertical }}px * 2.2) calc({{ section.settings.button_padding_horizontal }}px * 2.2);
            border-radius: calc({{ section.settings.button_radius }}px * 2.2);
        }
        .image-banner-content-{{ section.id }} .button-additional-text{
            font-size: calc({{ section.settings.font-size }}px * 2.2);
        }
    }
</style>
    <div class="mt-image-banner-new-wrapper-{{ section.id }}">
        <div class="mt-image-banner-new-container-{{ section.id }}">
            {% if section.settings.link != blank %}
                <a href="{{ section.settings.link }}">
            {% endif %}
            {% if section.settings.image != blank %}
                {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'mt-image-banner-new-desktop-image' }}
            {% endif %}
            {% if section.settings.mobile-image != blank %}
                <img class="mt-image-banner-new-mobile-image" src="{{ section.settings.mobile-image | image_url: width: 2000}}" width="" height="" alt="">
            {% endif %}
            <div class="mt-image-banner-new-content-{{ section.id }} page-width">
                <div class="image-banner-content-{{ section.id }}">
                    <div class="image-banner-text" style="color: {{ section.settings.text_color }};">
                    {% if section.settings.heading != blank %}
                        <div class="image-banner-new-heading">
                        {{ section.settings.heading }}
                        </div>
                    {% endif %}

                    {% if section.settings.subheading != blank %}
                        <div class="image-banner-new-subheading">
                        {{ section.settings.subheading }}
                        </div>
                    {% endif %}
                    </div>
                    <div class="image-banner-btn-wrapper" style="text-align: {{ section.settings.button_alignment }};margin-top: {{ section.settings.button_margin }}px">
                        <a 
                            href="{{ section.settings.button_link }}" 
                            class="image-banner-btn-{{ section.id }}"
                            style="
                            
                            "
                        >
                            {{ section.settings.button_text }}
                        </a>
                        {% if  section.settings.button_below_text != blank%}
                            <p class="button-additional-text" style=""
                            >{{ section.settings.button_below_text }}</p>
                        {% endif %}
                        </div>
                </div>
            </div>
            {% if section.settings.link != blank %}
                </a>
            {% endif %}
        </div>
    </div>


{% schema %}
{
  "name": "Image Banner New",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
    "type": "header",
    "content": "Layout"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-banner.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile-image",
      "label": "Mobile Image"
    },
    {
        "type": "range",
        "id": "content_width",
        "min": 200,
        "max": 600,
        "step": 20,
        "unit": "px",
        "label": "Content Width",
        "default": 400
    },
    {
    "type": "select",
    "id": "content_alignment",
    "label": "Content alignment",
    "default": "flex-start",
    "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
    ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
    "type": "header",
    "content": "Heading"
    },
    {
        "type": "richtext",
        "id": "heading",
        "label": "Heading"
    },
    {
        "type": "range",
        "id": "heading_font_size",
        "min": 12,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Font size",
        "default": 16
    },
    {
        "type": "select",
        "id": "heading_font_weight",
        "label": "Heading font weight",
        "default": "700",
        "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra-bold" }
        ]
    },
    {
        "type": "checkbox",
        "id": "custom-heading-font",
        "label": "Custom Heading Font",
        "default": false
    },
    {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "work_sans_n6",
        "visible_if": "{{ section.settings.custom-heading-font }}"
    },
    {
    "type": "header",
    "content": "Subheading"
    },
    {
        "type": "richtext",
        "id": "subheading",
        "label": "Subheading"
    },
    {
        "type": "range",
        "id": "subheading_font_size",
        "min": 12,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Font size",
        "default": 16
    },
    {
        "type": "select",
        "id": "subheading_font_weight",
        "label": "Subeading font weight",
        "default": "700",
        "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra-bold" }
        ]
    },
    {
        "type": "checkbox",
        "id": "custom-subheading-font",
        "label": "Custom Subheading Font",
        "default": false
    },
    {
        "type": "font_picker",
        "id": "subheading_font",
        "label": "Subheading font",
        "default": "work_sans_n6",
        "visible_if": "{{ section.settings.custom-heading-font }}"
    },
    {
        "type": "header",
        "content": "Text color"
    },
    {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#000000"
    },
    {
        "type": "header",
        "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Click me"
    },
    {
      "type": "number",
      "id": "button_margin",
      "label": "Top Margin",
      "default": 0
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
        "type": "checkbox",
        "id": "button_full_width",
        "label": "Button Full Width",
        "default": false
    },
    {
        "type": "select",
        "id": "button_font_weight",
        "label": "Button font weight",
        "default": "600",
        "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra-bold" },
            { "value": "900", "label": "Bolder" }
        ]
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 10
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Border radius (px)",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 6
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "Button alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
        "type": "header",
        "content": "Additional Text"
    },
    {
        "type": "checkbox",
        "id": "additional_layout",
        "label": "Horizontal Layout",
        "default": false
    },
    {
      "type": "text",
      "id": "button_below_text",
      "label": "Additional text",
      "default": "Button Additional Text"
    },
    {
        "type": "select",
        "id": "below_text_font_weight",
        "label": "font weight",
        "default": "600",
        "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra-bold" }
        ]
    },
    {
        "type": "range",
        "id": "font-size",
        "min": 10,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Font Size",
        "default": 12
    },
    {
      "type": "color",
      "id": "button_below_text_color",
      "label": "Additional Text color",
      "default": "#000000"
    },
    {
        "type": "url",
        "id": "link",
        "label": "Link"
    }
    ],
    "presets": [
        {
            "name": "Image Banner New"
        }
    ]
}

{% endschema %}

