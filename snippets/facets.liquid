<script>
  document.addEventListener("DOMContentLoaded", function() {
      
      const sortButton = document.getElementById("sortButton");
      const sortDropdown = document.getElementById("sortDropdown");
      const sortMobOptions = document.querySelectorAll("#sortDropdown li");
  
      // Get current URL parameters to highlight the selected option
      const urlParams = new URLSearchParams(window.location.search);
      const currentSort = urlParams.get("sort_by");

      function updateURL(sortBy) {
        const url = new URL(window.location.href);
        url.searchParams.set("sort_by", sortBy);
        window.history.pushState({}, "", url); // Update the browser URL without refreshing
        //console.log("URL updated");
    }
  
      // Highlight the current sort option on page load
      if (currentSort) {
          sortMobOptions.forEach(option => {
              if (option.getAttribute("data-sort") === currentSort) {
                  option.classList.add("active-sort");
                  sortButton.textContent = `Sort By`;
              }
          });
      }
  
      // Toggle dropdown on button click
      sortButton.addEventListener("click", function() {
          sortDropdown.classList.toggle("sort-hidden");
      });
  
      // Handle sort option click
      sortMobOptions.forEach(item => {
          item.addEventListener("click", function() {
              const selectedSort = this.getAttribute("data-sort");
              sortDropdown.classList.add("sort-hidden");
              sortButton.textContent = `Sort By`;
              updateURL(selectedSort);
  
              // Remove active class from all options & add to the selected one
              sortMobOptions.forEach(option => option.classList.remove("active-sort"));
              this.classList.add("active-sort");
  
              // Update URL and fetch new sorted products via AJAX
              const url = new URL(window.location.href);
              url.searchParams.set("sort_by", selectedSort);
            //console.log("sort clicked");

            // Clear existing product grid before replacing with new sorted items
            const oldGrid = document.querySelector(".product-grid");
            if (oldGrid) {
              const newEmptyGrid = oldGrid.cloneNode(false); // clone structure without children
              oldGrid.parentNode.replaceChild(newEmptyGrid, oldGrid);
            }
  
              fetch(url)
  .then(response => response.text())
  .then(data => {
    const parser = new DOMParser();
    const doc = parser.parseFromString(data, "text/html");

    const newProducts = doc.querySelector(".product-grid");
    const newPagination = doc.querySelector("#AjaxinatePagination");
    //console.log("DOMparsed")
    if (newProducts) {
      //console.log("Fetch DOMparsed");
      document.querySelector(".product-grid").innerHTML = newProducts.innerHTML;

      // Replace or append pagination
      const existingPagination = document.querySelector("#AjaxinatePagination");
      if (existingPagination) {
        existingPagination.remove(); // Remove before replacing to avoid duplicates
      }

      if (newPagination) {
        const productGrid = document.querySelector(".collection-info-bottom");
        if (productGrid && newPagination) {
          productGrid.insertAdjacentElement("afterend", newPagination);
        }

        var endlessScroll = new Ajaxinate({
          method: 'scroll', // Change to 'click' if you want a button instead
          container: '#product-grid',
          pagination: '#AjaxinatePagination',
          callback: function(){
            setTimeout(function() {
              const totalProductsElement = document.getElementById('collectionProductCount');
              const totalProducts = totalProductsElement ? parseInt(totalProductsElement.textContent, 10) : 0;
            
              // Count visible products
              const products = document.querySelectorAll('#product-grid > li');
              const productCount = products.length;
            
              // Display the count somewhere if needed
              const countElement = document.getElementById('product-count');
              if (countElement) {
                countElement.textContent = `${productCount}`;
              }
            
              // Calculate percentage
              const percentage = totalProducts > 0 ? (productCount / totalProducts) * 100 : 0;
            
              // Update progress bar width
              const progressBar = document.getElementById('progress-bar');
              if (progressBar) {
                progressBar.style.width = `${percentage}%`;
              }
              document.dispatchEvent(new CustomEvent("swym:collections-loaded"));
            }, 200);
           
          }
          
        });
      }

      // Update counts
      const newCount = document.querySelectorAll("#product-grid > li").length;
      updateProductCount(newCount);
      updateProductCountsText();
      // setTimeout(() => {
      //     new Ajaxinate({
      //     method: 'scroll',
      //     container: '#product-grid',
      //     pagination: '#AjaxinatePagination',
      //     callback: function () {
      //       setTimeout(() => {
      //         const currentCount = document.querySelectorAll("#product-grid .grid__item").length;
      //         updateProductCount(currentCount);
      //         updateProductCountsText();
      
      //         const nextLink = document.querySelector("#AjaxinatePagination a");
      //         if (!nextLink) {
      //           document.getElementById("AjaxinatePagination")?.remove();
      //           console.log("No more pages — scroll pagination removed.");
      //         }
      //         document.dispatchEvent(new CustomEvent("swym:collections-loaded"));
      //       }, 500);
      //     }
      //   });
      // }, 200);
      function initializeAjaxinate() {
        new Ajaxinate({
          method: 'scroll',
          container: '#product-grid',
          pagination: '#AjaxinatePagination',
          callback: function () {
            setTimeout(() => {
              const currentCount = document.querySelectorAll("#product-grid .grid__item").length;
              updateProductCount(currentCount);
              updateProductCountsText();

              const nextLink = document.querySelector("#AjaxinatePagination a");
              if (!nextLink) {
                document.getElementById("AjaxinatePagination")?.remove();
                //console.log("No more pages — scroll pagination removed.");
              }
              document.dispatchEvent(new CustomEvent("swym:collections-loaded"));
            }, 200);
          }
        });
      }

      // ✅ Wait for DOM update before reinitializing
      setTimeout(() => {
        if (document.querySelector("#AjaxinatePagination a")) {
          initializeAjaxinate(); // Will re-bind scroll event
          //console.log("Ajaxinate reinitialized after sort");
        } else {
          //console.log("No pagination link — Ajaxinate not reinitialized");
        }
      }, 200);

      
    }
  })
  .catch(error => console.error("Error fetching sorted products:", error));
          });
      });
  
      // Close dropdown when clicking outside
      document.addEventListener("click", function(event) {
          if (!sortButton.contains(event.target) && !sortDropdown.contains(event.target)) {
              sortDropdown.classList.add("sort-hidden");
          }
      });
  });
  </script>

